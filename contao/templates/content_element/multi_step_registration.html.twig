{% extends "@Contao/content_element/_base.html.twig" %}

{% block content %}
    {% if message %}
        {% set message_attributes = attrs()
            .addClass('message')
            .addClass(message.type)
            .mergeWith(message_attributes|default)
        %}

        <div{{ message_attributes }}>{{ message.message }}</div>
    {% endif %}

    {% if form %}
        {{ form_start(form) }}
            {% set current_step = form.vars.cursor.currentStep %}

            {% block visible_steps %}
                {% if form.vars.visible_steps is defined and form.vars.visible_steps|length > 1 %}
                    {% set steps_attributes = attrs()
                        .addClass('multi-step-registration__steps')
                        .mergeWith(steps_attributes|default)
                    %}

                    <ol{{ steps_attributes }}>
                        {% for step in form.vars.visible_steps %}
                            {% set step_attributes = attrs()
                                .addClass('active', step.is_current_step)
                                .set('aria-current', 'step', step.is_current_step)
                                .mergeWith(step_attributes|default)
                            %}

                            <li{{ step_attributes }}>{{ steps[step.index].label }}</li>
                        {% endfor %}
                    </ol>
                {% endif %}
            {% endblock %}

            {% block errors %}
                {{ form_errors(form) }}
            {% endblock %}

            {% block widgets %}
                {% if attribute(form, current_step) is defined %}
                    {% set step_fieldset_attributes = attrs()
                        .addClass('multi-step-registration__step')
                        .mergeWith(step_fieldset_attributes|default)
                    %}

                    <fieldset{{ step_fieldset_attributes }}>
                        <legend>{{ steps[form.vars.cursor.stepIndex].label ?? current_step }}</legend>
                        {{ form_widget(attribute(form, current_step)) }}
                    </fieldset>
                {% endif %}
            {% endblock %}

            {% block captcha %}
                {% if captcha %}
                    {% set captcha_attributes = attrs()
                        .addClass('multi-step-registration__captcha')
                        .mergeWith(captcha_attributes|default)
                    %}

                    <div{{ captcha_attributes }}>
                        {{ captcha|raw }}
                    </div>
                {% endif %}
            {% endblock %}

            {% block navigator %}
                {% if form.navigator is defined %}
                    {% set navigator_attributes = attrs()
                        .addClass('multi-step-registration__navigator')
                        .mergeWith(navigator_attributes|default)
                    %}

                    <div{{ navigator_attributes }}>
                        {{ form_widget(form.navigator) }}
                    </div>
                {% endif %}
            {% endblock %}
        {{ form_end(form) }}
    {% endif %}
{% endblock %}
